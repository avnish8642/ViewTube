PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/viewtube
JWT_SECRET=super_secret_viewtube_jwt_key_2026_xyz
JWT_EXPIRE=7d
CLIENT_URL=https://viewtube-frontend-qfwz.onrender.com,http://localhost:5173

# Optional: Cloudinary credentials (If left blank, server automatically uses high-performance local video/image storage with HTTP range streaming)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP and trusted-device verification
OTP_SECRET=
TRUSTED_DEVICE_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Billing and moderated comments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MODERATOR_KEY=
BLOCKED_TERMS=
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# Remote media must be HTTPS and match an allowlisted hostname.
VIDEO_MEDIA_HOSTS=res.cloudinary.com

# Optional trusted GeoIP service; JSON response fields: city, state, country, latitude, longitude.
# Use {ip} where the service expects the address. Client IPs are sent only when this is configured.
GEOIP_LOOKUP_URL=
